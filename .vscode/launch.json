{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run main.py (no LLM)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${userHome}/anaconda3/envs/data_gov_agent/python.exe",
            "envFile": "${workspaceFolder}/.env",
            "args": ["--skip-llm"]
        },
        {
            "name": "Run main.py (with LLM)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${userHome}/anaconda3/envs/data_gov_agent/python.exe",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}
